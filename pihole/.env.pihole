#### Pihole setting to bootstrap the container

## Recommended settings
TZ=${TZ:-UTC}                           ## Define which midnight to rotate logs
WEBUI_PASSWORD=""                       ## If empty, random password will be recreated, unless "WEBPASSWORD_FILE" is defined
WEBPASSWORD_FILE="/run/secrets/webpassword"  ## Path where the WebUI password is stored using docker secrets
FTLCONF_LOCAL_IPV4=${HOST_IP}           ## LAN IP of Pihole/Host to perform "web blocks"

## Optional Variables
VIRTUAL_HOST=ns2                        ## Define virtual hostname/IP to access the pihole admin page
WEBTHEME="default-darker"

## Experimental Variables
PIHOLE_UID=${PUID_DOCKER:-999}
PIHOLE_GID=${PGID_DOCKER:-999}
ServerIP=${HOST_IP}