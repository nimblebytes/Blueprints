#### (Required) Container setup variable
IMAGE_TAG=""                                                ## Image version tag to use. If empty, default is "latest"
CONTAINER_IP_IPVLAN="${[IP_on_IPVLAN]}"                     ## IP if using IP Vlan instead of Host IP. Assigned by router, same subnet as HOST
CONTAINER_IP_MACVLAN="${[IP_on_MacVLAN]}"                   ## IP if using MacVlan instead of Host IP. Assigned by router, can be an subnet.

#### (Recommended) Container environment variables
PUID_DOCKER=${PUID_DOCKER:-1000}
PGID_DOCKER=${PGID_DOCKER:-1000}
TZ=${TZ:-Europe/Berlin}

#### (Optional) Variables for labels, tags, 
HOSTNAME=${HOSTNAME:-demoserver-01}                         ## Name to identify the host running the container
CONTAINER_NAME="pihole"                                     ## Name to use for the container. If empty defaults to "pihole"

#### (Recommended) Control where container config and runtime files are stored
DOCKER_VOLUMES="${DOCKER_VOLUMES:?}"                        ## Path to dynamic runtime files created by the container. If empty will use "./config"
CONTAINER_VOLUME="${DOCKER_VOLUMES:-.}/${CONTAINER_NAME:-volume_structure}"  ## Path to dynamic runtime files created by the container. If empty will use "./config"